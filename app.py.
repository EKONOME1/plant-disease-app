def humanize_label(label: str) -> str:
    return label.replace("___", " - ").replace("_", " ")


def normalize_probabilities(pred):
    arr = np.asarray(pred, dtype=np.float32).ravel()
    if arr.size == 0:
        return arr

    if np.min(arr) < 0 or np.max(arr) > 1.0 or np.isclose(np.sum(arr), 0):
        arr = tf.nn.softmax(arr).numpy()

    total = arr.sum()
    if total > 0 and not np.isclose(total, 1.0):
        arr = arr / total

    return arr


def preprocess_leaf_image(image: Image.Image, target_size=(224, 224)):
    img = image.convert("RGB")
    img = ImageEnhance.Contrast(img).enhance(1.4)

    arr = np.array(img)
    r = arr[:, :, 0].astype(np.float32)
    g = arr[:, :, 1].astype(np.float32)
    b = arr[:, :, 2].astype(np.float32)

    green_mask = (g > r) & (g > b) & ((g - r) > 12) & ((g - b) > 12)
    if green_mask.sum() > 0.02 * arr.shape[0] * arr.shape[1]:
        ys, xs = np.where(green_mask)
        if len(xs) > 0 and len(ys) > 0:
            x_min, x_max = xs.min(), xs.max()
            y_min, y_max = ys.min(), ys.max()
            img = img.crop((x_min, y_min, x_max + 1, y_max + 1))

    img = ImageOps.fit(img, target_size, method=Image.Resampling.LANCZOS)
    arr = np.asarray(img, dtype=np.float32) / 255.0
    return arr


def predict_single_image(model, classes, image):
    input_shape = model.input_shape
    if input_shape is not None and len(input_shape) >= 3:
        target_size = (input_shape[1], input_shape[2])
    else:
        target_size = (224, 224)

    processed = preprocess_leaf_image(image, target_size=target_size)
    processed = np.expand_dims(processed, axis=0)

    raw_pred = model.predict(processed, verbose=0)[0]
    probs = normalize_probabilities(raw_pred)

    best_idx = int(np.argmax(probs))
    predicted_class = classes[best_idx]
    confidence = float(probs[best_idx] * 100.0)
    display_name = humanize_label(predicted_class)

    return display_name, confidence, predicted_class


